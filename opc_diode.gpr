--  SPDX-License-Identifier: AGPL-3.0-or-later
--  Copyright (C) 2026 Alin Anton
--
--  opc-diode : a high-assurance Ada/SPARK OPC UA PubSub data-diode relay.
--
--  The source high-security network publishes OPC UA PubSub (UADP over UDP);
--  we listen, protect the stream for a one-way lossy link (sequence-number
--  dedup, interleaved repetition, and erasure coding sized to the message),
--  cross the diode, and re-emit byte-identical UADP to the low-security side.
--
--  Because the transport is native PubSub, there is NO OPC UA stack anywhere:
--  the data path only parses the UADP header (to dedup and route) and treats
--  each DataSetMessage as an opaque, verbatim payload.  The whole path can
--  therefore live in the proven SPARK core under src/core.
with "deps/sparknacl/sparknacl.gpr";

project Opc_Diode is

   --  Optional DPDK poll-mode transport (kernel bypass).  Default OFF: a plain
   --  build compiles no C and links no DPDK, keeping the trusted shell exactly
   --  as docs/ASSURANCE.md describes it.  Turn it on with
   --     WITH_DPDK=yes ./tools/build.sh
   --  which also exports DPDK_CFLAGS / DPDK_LIBS from `pkg-config libdpdk`.
   type Yes_No is ("no", "yes");
   With_Dpdk : Yes_No := external ("WITH_DPDK", "no");

   --  Optional high-side OPC UA client adapter (for sources that speak
   --  client/server, not native PubSub).  The stack is a large third-party C
   --  body, so it is opt-in and stays on the high side (docs/ASSURANCE.md).
   type Opcua_Kind is ("none", "s2opc", "open62541");
   With_Opcua : Opcua_Kind := external ("WITH_OPCUA", "none");

   Net_Dir := "src/net/stub";
   case With_Dpdk is
      when "yes" => Net_Dir := "src/net/dpdk";
      when "no"  => Net_Dir := "src/net/stub";
   end case;

   Adapter_Dir := "src/adapter/none";
   case With_Opcua is
      when "none"      => Adapter_Dir := "src/adapter/none";
      when "s2opc"     => Adapter_Dir := "src/adapter/s2opc";
      when "open62541" => Adapter_Dir := "src/adapter/open62541";
   end case;

   for Source_Dirs use
     ("src/core", "src", "tests", "src/net", "src/adapter", Net_Dir, Adapter_Dir);

   --  C is compiled if either the DPDK shim or an OPC UA shim is present.
   case With_Dpdk is
      when "yes" => for Languages use ("Ada", "C");
      when "no"  =>
         case With_Opcua is
            when "none" => for Languages use ("Ada");
            when others => for Languages use ("Ada", "C");
         end case;
   end case;

   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("test_core.adb", "od_sender.adb", "od_receiver.adb",
                        "od_probe.adb", "od_adapter.adb");

   package Compiler is
      --  Assertions off at run time: the SPARK contracts are discharged
      --  statically by gnatprove (tools/prove.sh), not re-checked at run time.
      for Default_Switches ("Ada") use
        ("-g", "-O2", "-gnat2022", "-gnatwa");

      case With_Dpdk is
         when "yes" =>
            for Default_Switches ("C") use
              ("-O2", "-g", "-Wall", "-Wextra")
              & external_as_list ("DPDK_CFLAGS", " ");
         when "no" =>
            case With_Opcua is
               when "none" => null;
               when others =>
                  for Default_Switches ("C") use
                    ("-O2", "-g", "-Wall")
                    & external_as_list ("OPCUA_CFLAGS", " ");
            end case;
      end case;
   end Compiler;

   package Linker is
      --  DPDK_LIBS must come from `pkg-config --STATIC --libs libdpdk`: the
      --  --whole-archive it emits pulls the PMD constructors out of the
      --  archives so ports self-register at run time.
      case With_Dpdk is
         when "yes" =>
            for Default_Switches ("Ada") use
              external_as_list ("DPDK_LIBS", " ");
         when "no" =>
            case With_Opcua is
               when "none" => null;
               when others =>
                  for Default_Switches ("Ada") use
                    external_as_list ("OPCUA_LIBS", " ");
            end case;
      end case;
   end Linker;

   package Builder is
      for Default_Switches ("Ada") use ("-j0");
   end Builder;

   package Prove is
      --  --steps raised from the level-2 default: the K=72 Reed-Solomon instance
      --  makes the index/overflow VCs larger, and the provers need the extra
      --  budget to close them (they do -- 0 unproved).  --no-subprojects keeps
      --  the vendored, separately-proven SPARKNaCl out of our scope.
      for Proof_Switches ("Ada") use
        ("--level=2", "--steps=25000", "--no-subprojects", "--report=all");
   end Prove;

end Opc_Diode;
